{
  "name": "rolebridge",
  "version": "0.11.0",
  "private": true,
  "description": "Private, browser-based CV intake and vacancy comparison for RoleBridge",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "refresh:vacancies": "node scripts/refresh-vacancies.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
